{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build EHR for VS Code",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}\\Patient.EHR.Frontend\\Patient.EHR.csproj",
        "--no-restore",
        "-p:UseAppHost=false",
        "-p:OutputPath=${workspaceFolder}\\Patient.EHR.Frontend\\bin\\Debug\\net8.0-vscode"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
